# ========================================
# 智谱 AI API Key（必填）
# 获取地址：https://open.bigmodel.cn/
# ========================================
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# 聊天模型（默认免费版）；可选 glm-4.5-air 等
CHAT_MODEL=glm-4-flash-250414
# 向量模型（检索仍可能计费）
EMBEDDING_MODEL=embedding-2

# ========================================
# JWT 加密密钥（必填，生产环境务必修改）
# 建议使用 32 位以上的随机字符串
# 可以用命令生成：openssl rand -hex 32
# ========================================
JWT_SECRET_KEY=your_jwt_secret_key_here

# ========================================
# 前端跨域白名单（可选）
# 多个用逗号分隔；本地 localhost / 127.0.0.1 的任意端口默认放行
# 部署时把线上前端域名加进来，例：
#   ALLOW_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# ========================================
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173